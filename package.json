{
  "name": "pilldiff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/prepare-catalog.ts --snapshot && vite",
    "build": "tsc --noEmit && tsx scripts/prepare-catalog.ts --live && vite build",
    "build:snapshot": "tsc --noEmit && tsx scripts/prepare-catalog.ts --snapshot && vite build",
    "start": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx tests/browser/live-smoke.ts",
    "sync": "tsx scripts/sync.ts"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "24.x"
  }
}
